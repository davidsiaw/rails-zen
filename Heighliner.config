# frozen_string_literal: true
#
# Heighliner.config — local dev environment for rails-zen.
#   https://davidsiaw.github.io/heighliner
#
#   heighliner init rails-zen
#   heighliner up -av
#   open "http://rails-zen.$(heighliner show http-suffix)"
#
# Mirrors docker-compose.yml (Postgres + Redis + app), minus the dev-only tool
# containers (pgadmin, selenium, video recorder).

dockerfile 'Dockerfile'

# Falcon's port inside the container. Heighliner reverse-proxies a random host
# port to it, so nothing is occupied on the host.
expose 3000

plugin :database

# port: 5432 is required — Heighliner defaults to 3306 (MySQL's) and `up` then
# hangs forever on "Waiting for database to start...".
#
# The version is pinned because Heighliner snapshots the Postgres data directory,
# and those snapshots are not portable across majors. docker-compose.yml's
# floating `postgres:alpine` would break restores the day upstream bumps.
def_db postgres: {
  version: '16-alpine',
  root_password: 'postgres',
  port: 5432
}

# Replace the stock readiness probe. Heighliner's is
#   until psql ... || [ $RETRIES -eq 0 ]
# with RETRIES=5: it gives up after ~5s and exits 0 whether or not Postgres ever
# answered, so on a cold initdb provisioning starts against a database that is
# not accepting connections yet. def_db has no passthrough for this, but the
# Steerfile is instance_eval'd and exposes `database`, so it can be set here.
# PG_* come from the driver's waitscript_params.
database[:waitscript] = <<~SH
  #!/bin/sh
  n=0
  until psql -h "$PG_HOST" -U "$PG_USER" -d "$PG_DATABASE" -c 'select 1' >/dev/null 2>&1; do
    n=$((n + 1))
    [ $n -ge 30 ] && { echo "postgres never became ready"; exit 1; }
    echo "waiting for postgres... ($n)"
    sleep 2
  done
SH

service 'redis', image: 'redis:alpine'

# Appended to `docker run`. ERB is evaluated against Heighliner's Cli binding,
# so envname / db_container_name are available; service containers are named
# <envname>-<service>.
#
#   --network-alias  the app container otherwise has no DNS name at all, just a
#                    raw container id that changes on every `up`. Only the
#                    browser specs need to address it — via TEST_HOST below.
#   CHROME_HOSTNAME  app -> Selenium. Switches spec/browser_helper.rb to its
#                    remote branch. `heighliner-chrome` is long-lived on the
#                    shared network, so unlike docker-compose.yml this
#                    environment starts no chrome of its own.
#   TEST_HOST        Selenium -> Capybara (0.0.0.0:4000 in here). The opposite
#                    direction, hence not localhost: different containers.
#                    Defaults to 'rails', a compose-only name, so it must be set.
app_params "
  -e DATABASE_URL=postgres://postgres:postgres@<%= db_container_name %>
  -e REDIS_URL=redis://<%= envname %>-redis:6379/0
  --network-alias <%= envname %>-app
  -e CHROME_HOSTNAME=heighliner-chrome
  -e TEST_HOST=<%= envname %>-app
"

# Provisions a fresh volume; the result is snapshotted as the 'default' image and
# restored by `heighliner db_reset`. A half-provisioned result gets cached just as
# happily and is then permanent — `heighliner db_reset_hard` discards it and rebuilds.
# Readiness is the waitscript's job, above.
db_reset_command 'sh bin/dbsetup'

# `heighliner attach` / `up -a` only. tmp/ and log/ are deliberately not mounted:
# a host tmp/pids/server.pid leaking in stops Falcon from booting.
attach_mount 'app',    '/srv/app'
attach_mount 'config', '/srv/config'
attach_mount 'db',     '/srv/db'
attach_mount 'lib',    '/srv/lib'
attach_mount 'spec',   '/srv/spec'

# Do not add `type :http`. It polls `/` for a 200, but config/routes.rb mounts
# RootApi there and its `route :any, '*path'` catch-all returns 404, so every
# `up` would abort on a perfectly healthy app. The real health endpoint is
# /api/v1/health, which this check cannot be pointed at.
