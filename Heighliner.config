# frozen_string_literal: true
#
# Steerfile — local development environment for rails-zen under Heighliner.
#   https://github.com/davidsiaw/heighliner
#
# Usage:
#   heighliner init railszen
#   heighliner up
#   open http://railszen.lvh.me
#
# This mirrors what docker-compose.yml sets up (Postgres + Redis + the app),
# minus the dev-only tool containers (pgadmin, selenium, video recorder).

# Reuses the existing image build. Context is the project root, same as
# `docker-compose build`, so the ADD lines in the Dockerfile resolve as usual.
dockerfile 'Dockerfile'

# The port Falcon listens on inside the container. Heighliner picks a random
# host port and reverse-proxies railszen.lvh.me to it, so nothing is occupied
# on the host. Matches EXPOSE 3000 / `rails s -p 3000` in the Dockerfile.
expose 3000

plugin :database

# Postgres. `root_password` matches the default baked into config/database.yml
# (`postgres://postgres:postgres@127.0.0.1`), so DATABASE_URL below is the only
# thing the app needs told.
#
# `port: 5432` is not optional. lib/heighliner/databases/postgres.rb defaults
# to `port = @options[:port] || 3306` — MySQL's port, evidently copy-pasted —
# and that value becomes the container's published port and the one the
# waitscript polls. Leaving it out makes `heighliner up` hang on "Waiting for
# database to start...".
#
# The version is pinned deliberately: Heighliner snapshots the Postgres data
# directory to ~/.heighliner/<env>/<branch>/default.tar.bz, and those snapshots
# are not portable across major versions. docker-compose.yml uses the floating
# `postgres:alpine`, which will silently break restores when upstream bumps.
def_db postgres: {
  version: '16-alpine',
  root_password: 'postgres',
  port: 5432
}

# Redis, for Rails.cache, ActionCable and Sidekiq's queue.
# Heighliner names service containers <envname>-<name> on the shared network,
# hence the hostname in REDIS_URL below.
service 'redis', image: 'redis:alpine'

# Passed to `docker run` for the app container. ERB is evaluated against
# Heighliner's Cli binding, so db_container_name / envname are available.
app_params "
  -e DATABASE_URL=postgres://postgres:postgres@<%= db_container_name %>
  -e REDIS_URL=redis://<%= envname %>-redis:6379/0
"

# Run once against a fresh volume to provision the database; the result is then
# snapshotted as the 'default' image and restored by `heighliner db_reset`.
#
# This was `sh bin/dbsetup`, which silently half-provisions. Two heighliner
# behaviours combine badly:
#
#   1. lib/heighliner/databases/postgres.rb's waitscript is
#        until psql ... || [ $RETRIES -eq 0 ]
#      with RETRIES=5. It gives up after ~5s and exits 0 either way, so on a
#      cold `initdb` the provisioning container starts before Postgres accepts
#      connections.
#
#   2. bin/dbsetup has no `set -e`, so its exit status is just that of the last
#      line. Early failures are invisible; heighliner sees 0, snapshots a
#      half-built database as default.tar.bz, and `setup_db` then does
#        return if File.exist?(default_db_image)
#      on every subsequent `up` — so the broken state is permanent and silent.
#
# So: retry db:create until Postgres answers (it is idempotent, and doubles as
# the readiness probe), then `set -e` so anything after it fails loudly.
#
# `rails db:create` in development creates the test database too, but does not
# load a schema into it; the explicit test-env line does that, so `bin/rspec`
# works without waiting on maintain_test_schema!.
db_reset_command <<~SH.gsub(/\s+/, ' ').strip
  sh -c '
    n=0;
    until bundle exec rails db:create; do
      n=$((n+1));
      [ $n -ge 15 ] && { echo "postgres never became ready"; exit 1; };
      echo "waiting for postgres...";
      sleep 2;
    done;
    set -e;
    bundle exec rails db:migrate db:seed;
    bundle exec rails db:create db:schema:load RAILS_ENV=test
  '
SH

# Only used by `heighliner attach` / `heighliner up -a`, which bind-mounts the
# source into the container so edits are live. tmp/ and log/ are deliberately
# not mounted — tmp/pids/server.pid leaking in from the host causes Falcon to
# refuse to boot.
attach_mount 'app',    '/srv/app'
attach_mount 'config', '/srv/config'
attach_mount 'db',     '/srv/db'
attach_mount 'lib',    '/srv/lib'
attach_mount 'spec',   '/srv/spec'

# NOT enabled on purpose:
#
# type :http
#
# This makes `heighliner up` poll the app and fail unless it gets a 200. It
# polls `http://<app>:3000/` with no configurable path, and this app has no
# root route — config/routes.rb mounts RootApi at '/', whose `route :any,
# '*path'` catch-all returns 404. So `type :http` would abort every `up` with
# "Failed with HTTP status: 404" on a perfectly healthy app.
#
# Enable it only after adding a 200 at '/'. The health endpoint that already
# exists is at /api/v1/health, which this check cannot be pointed at.
