#!/usr/bin/env bash
# frozen_string_literal: false
#
# Prepares this Rails project to run locally inside a pa-style sandbox container.
# Installs system deps (PostgreSQL, Redis, Chromium) via pa-apt, starts them,
# bundles gems, and sets up the DB.
#
# Usage:
#   bin/setuplocal [ruby_version]
#
# After setup, start the server with:
#   source tmp/localenv.sh
#   bin/rails server -u falcon -p 3000
#
set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_ROOT"

# ── Colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[setuplocal]${NC} $*"; }
warn()  { echo -e "${YELLOW}[setuplocal]${NC} $*"; }
fail()  { echo -e "${RED}[setuplocal]${NC} $*"; exit 1; }

# ── 1. Ruby via mise ────────────────────────────────────────────────────────
info "Checking Ruby..."

# Accept optional Ruby version from argument, default 3.4.10
# Minimum is 3.4 -- see the MINIMUM_RUBY check below for why.
DEFAULT_RUBY="3.4.10"
TARGET_RUBY="${1:-$DEFAULT_RUBY}"
MINIMUM_RUBY="3.4"

# Resolve mise path
MISE_RUBY="$(mise where ruby@$TARGET_RUBY 2>/dev/null || true)"
if [ -n "$MISE_RUBY" ] && [ -x "$MISE_RUBY/bin/ruby" ]; then
  export PATH="$MISE_RUBY/bin:$PATH"
elif [ -x "$HOME/.local/share/mise/installs/ruby/$TARGET_RUBY/bin/ruby" ]; then
  export PATH="$HOME/.local/share/mise/installs/ruby/$TARGET_RUBY/bin:$PATH"
elif command -v ruby &>/dev/null; then
  warn "Ruby $TARGET_RUBY not found via mise, using system ruby."
else
  fail "Ruby $TARGET_RUBY not found. Install with: mise install ruby@$TARGET_RUBY"
fi
info "Ruby $(ruby --version | awk '{print $2}')"

# Reject dev-build Rubies (precompiled native gems fail against dev builds)
if [ "$(ruby -e 'print RUBY_PATCHLEVEL')" -lt 0 ]; then
  fail "Ruby $TARGET_RUBY is a development build ($(ruby -v)).
Precompiled native gems (pg, nokogiri) cannot load against dev builds
(undefined symbol: ruby_abi_version).
Use a released version instead."
fi

# Enforce the minimum Ruby. Checks the *running* ruby, not TARGET_RUBY, because
# the block above may have fallen back to system ruby.
if ! ruby -e "exit Gem::Version.new(RUBY_VERSION) >= Gem::Version.new('$MINIMUM_RUBY')"; then
  fail "Ruby $(ruby -e 'print RUBY_VERSION') is too old; this project requires >= $MINIMUM_RUBY.
Ruby < 3.3.7 has a Mutex/ConditionVariable bug (https://bugs.ruby-lang.org/issues/20907)
that makes Async raise 'Attempt to unlock a mutex which is not locked' during
fiber scheduler cancellation, producing spurious errors on Falcon teardown.
Install a supported Ruby with: mise install ruby@$DEFAULT_RUBY"
fi

# Write .ruby-version only after all validation passes
echo "$TARGET_RUBY" > "$APP_ROOT/.ruby-version"

# ── 2. System dependencies (pa-apt, no sudo) ────────────────────────────────
info "Installing system dependencies..."

NEED_PG=false
NEED_REDIS=false
NEED_CHROME=false

# Check if already installed (pa-apt puts binaries on PATH)
# Note: initdb is under /usr/lib/postgresql/X/bin/ (not on PATH), so check psql instead
if ! command -v psql &>/dev/null; then
  NEED_PG=true
fi
if ! command -v redis-server &>/dev/null; then
  NEED_REDIS=true
fi
if ! command -v chromium &>/dev/null; then
  NEED_CHROME=true
fi

if [ "$NEED_PG" = true ] || [ "$NEED_REDIS" = true ] || [ "$NEED_CHROME" = true ]; then
  if [ "$NEED_PG" = true ]; then
    info "Installing PostgreSQL..."
    pa-apt install postgresql 2>&1 | tail -3 || true
  fi
  if [ "$NEED_REDIS" = true ]; then
    info "Installing Redis..."
    pa-apt install redis 2>&1 | tail -3 || true
  fi
  if [ "$NEED_CHROME" = true ]; then
    info "Installing Chromium..."
    pa-apt install chromium 2>&1 | tail -3 || true
  fi
fi

# ── 3. Start PostgreSQL ─────────────────────────────────────────────────────
info "Starting PostgreSQL..."

# Find the PostgreSQL version from the installed libraries
PA_APT_ROOT="$(pa-apt path 2>/dev/null)" || PA_APT_ROOT="$HOME/.local/pa-apt"
PG_LIB_DIR="$(find "$PA_APT_ROOT/usr/lib/postgresql" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -1)" || true
if [ -z "$PG_LIB_DIR" ]; then
  fail "Cannot find PostgreSQL installation. Check pa-apt install postgresql."
fi
PG_BIN="$PG_LIB_DIR/bin"

# User-writable directories for data and sockets (no /var/run or sudo)
PG_DATA="$HOME/.local/pgdata"
PG_RUN="$HOME/.local/pg-run"
mkdir -p "$PG_DATA" "$PG_RUN"

# Check if a cluster already exists at PG_DATA
if [ ! -f "$PG_DATA/PG_VERSION" ]; then
  info "Initializing PostgreSQL cluster..."
  "$PG_BIN/initdb" -D "$PG_DATA" --auth=trust --encoding=UTF8 > /dev/null 2>&1

  # Configure user-writable socket directory (avoids /var/run permission issues)
  echo "unix_socket_directories = '$PG_RUN'" >> "$PG_DATA/postgresql.conf"
fi

# Start the server
if "$PG_BIN/pg_isready" -h "$PG_RUN" -q 2>/dev/null; then
  info "PostgreSQL already running."
else
  info "Starting PostgreSQL server..."
  "$PG_BIN/pg_ctl" -D "$PG_DATA" -l "$PG_DATA/logfile" start 2>&1 | tail -3
fi

# Create 'postgres' role if it doesn't exist (initdb creates a role matching
# the OS user, but Rails expects 'postgres' by convention)
"$PG_BIN/createuser" -h "$PG_RUN" -s postgres 2>/dev/null || true

# Wait for readiness
for i in $(seq 1 30); do
  "$PG_BIN/pg_isready" -h "$PG_RUN" -q && break
  sleep 1
done
"$PG_BIN/pg_isready" -h "$PG_RUN" -q || fail "PostgreSQL failed to start."
info "PostgreSQL ready."

# ── 4. Start Redis ──────────────────────────────────────────────────────────
info "Starting Redis..."
if redis-cli ping 2>/dev/null | grep -q PONG; then
  info "Redis already running."
else
  redis-server --daemonize yes --loglevel warning 2>/dev/null || \
    fail "Redis failed to start."
fi
redis-cli ping | grep -q PONG || fail "Redis failed to start."
info "Redis ready."

# ── 5. Bundle install ───────────────────────────────────────────────────────
info "Installing Ruby gems..."
bundle check 2>/dev/null || bundle install

# ── 6. Rails master key (credentials) ───────────────────────────────────────
if [ ! -f "$APP_ROOT/config/master.key" ]; then
  info "Generating master key for credentials..."
  KEY=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(16)')
  echo "$KEY" > "$APP_ROOT/config/master.key"

  if [ -f "$APP_ROOT/config/credentials.yml.enc" ]; then
    info "Removing stale credentials.yml.enc (key mismatch)..."
    rm -f "$APP_ROOT/config/credentials.yml.enc"
  fi

  info "Master key written to config/master.key"
else
  info "Master key already exists."
fi

# ── 6b. Container patches (RUBYOPT) ─────────────────────────────────────────
# Two monkey-patches needed in the sandbox:
#   1. listen gem → force polling (host inotify pool exhausted)
#   2. Chrome → headless + no-sandbox (no display, unprivileged user)
CONTAINER_PATCH="$APP_ROOT/tmp/container_patches.rb"
mkdir -p "$APP_ROOT/tmp"
cat > "$CONTAINER_PATCH" <<'RUBY'
# Force listen into polling mode (inotify exhausted in container)
require "listen"
Listen::Adapter.class_eval { def self.select(_options = {}); Listen::Adapter::Polling; end }

# Force Chrome headless + no-sandbox for container environments
require "selenium/webdriver"
Selenium::WebDriver::Chrome::Options.prepend(Module.new do
  def initialize(*)
    super
    add_argument("--headless=new")
    add_argument("--no-sandbox")
    add_argument("--disable-gpu")
    add_argument("--disable-dev-shm-usage")
  end
end)
RUBY
export RUBYOPT="-r$CONTAINER_PATCH${RUBYOPT:+ $RUBYOPT}"
info "Patched listen → polling, Chrome → headless+no-sandbox"

# ── 7. Database setup ───────────────────────────────────────────────────────
export DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432"
export REDIS_URL="redis://127.0.0.1:6379/0"

info "Setting up development database..."
bundle exec rails db:create db:migrate db:seed RAILS_ENV=development 2>&1 | while IFS= read -r line; do echo "  $line"; done

info "Setting up test database..."
bundle exec rails db:create db:migrate RAILS_ENV=test 2>&1 | while IFS= read -r line; do echo "  $line"; done

# ── 8. Emit env file for use in a fresh shell ───────────────────────────────
cat > "$APP_ROOT/tmp/localenv.sh" <<EOF
export PATH="$(dirname "$(command -v ruby)"):\$PATH"
export DATABASE_URL="$DATABASE_URL"
export REDIS_URL="$REDIS_URL"
export RUBYOPT="-r$CONTAINER_PATCH"
EOF

# ── Done ─────────────────────────────────────────────────────────────────────
echo ""
echo "========================================="
echo "  Setup complete!"
echo "========================================="
echo ""
echo "  Start the server:"
echo "    source tmp/localenv.sh"
echo "    bin/rails server -u falcon -p 3000"
echo ""
echo "  Run tests:"
echo "    source tmp/localenv.sh"
echo "    bundle exec rspec"
echo ""
